  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "string"
          },
          "serial": {
            "type": "string",
            "description": "完整 24 位十六进制设备序列号，推荐大写；示例全零只作占位",
            "example": "000000000000000000000000"
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": true
      },
      "TextRequest": {
        "type": "object",
        "description": "推荐显式传字符串 text；未传时服务提交空字符串。请求体总上限 16384 UTF-8 字节。",
        "properties": {
          "text": {
            "type": "string",
            "example": "Hello V1PRO / V2"
          }
        },
        "additionalProperties": true
      },
      "Accepted": {
        "type": "object",
        "description": "请求已交给 GUI，不能据此认定设备已显示或完成。",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "ok"
        ]
      },
      "DeviceStatus": {
        "type": "object",
        "description": "GUI 缓存的逻辑状态。识别、容量、异常状态字段可能缺省，部分异常子进程记录不含 ok。",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "guiRunning": {
            "type": "boolean"
          },
          "connected": {
            "type": "boolean"
          },
          "serial": {
            "type": "string",
