  "paths": {
    "/live": {
      "post": {
        "operationId": "submitLiveText",
        "summary": "向主窗口提交实时文字",
        "description": "异步交给 GUI 主窗口 core；不按 serial 路由，不返回任务编号。200 只表示提交，设备未连接或被其他模式占用时可能随后不执行。忙碌期间仅保留最新一条待发送文字。",
        "tags": [
          "文字"
        ],
        "requestBody": {
          "required": false,
          "description": "UTF-8 JSON 对象，总请求体最多 16384 字节；提供 Content-Length，不使用 chunked 请求体。",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "处理成功；含义以对应接口说明为准",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "description": "请求体或参数格式错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "网页 Origin 不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "接口回调异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "summary": "浏览器 CORS 预检",
        "description": "按 Origin 验证；声明允许 GET, POST, OPTIONS 和 Content-Type。声明的 Private-Network 响应头不保证每个浏览器都可访问。",
        "tags": [
          "CORS"
        ],
        "responses": {
          "204": {
            "description": "允许的 Origin 预检成功"
          },
          "403": {
            "description": "Origin 不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
